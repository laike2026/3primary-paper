# Public canonical origin, without trailing slash
NEXT_PUBLIC_SITE_URL=https://tpc-paper.com
# Enable indexing only after production content and domain QA.
INDEXING_ENABLED=false
# Vercel-managed Neon: pooled URL for API traffic, direct URL for migration/backup.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Blob public store token (server-side only).
BLOB_READ_WRITE_TOKEN=
# Generate independent random values; never commit them.
INQUIRY_HASH_SECRET=
CRON_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
# Mail notifications/password reset require a verified sender domain.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=
# Server-only Search Console sync (never prefix the JSON credential with NEXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:tpc-paper.com
# Local encrypted backup / disposable restore drill only.
BACKUP_PASSPHRASE=
RESTORE_DATABASE_URL=
RESTORE_ALLOW_DISPOSABLE=no
