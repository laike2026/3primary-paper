# Public canonical origin, without trailing slash
NEXT_PUBLIC_SITE_URL=https://tpc-paper.com
# Set to true only after the public launch checklist is complete.
INDEXING_ENABLED=false
# Use the pooled URL for serverless application traffic.
DATABASE_URL=
# Resend requires a verified sending domain and API key.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_HASH_SECRET=
INQUIRY_NOTIFY_EMAIL=alex.chen@3primary.com
# Server-only Search Console sync (never prefix the JSON credential with NEXT_PUBLIC_).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:tpc-paper.com
